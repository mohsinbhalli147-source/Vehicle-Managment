# Copy to .env.local and fill in your real values.
# These are PUBLIC keys (safe to expose in the browser) — never put service_role/secret keys here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Hosting project (public, used by firebase CLI via .firebaserc)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sardar-autos